NODE_ENV=production

# Database
DATABASE_URL=your_mongodb_connection_string

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend + CORS
ALLOWED_ORIGINS=https://sypeministry.netlify.app,https://sypeministry.org
SITE_URL=https://www.sypeministry.org
VITE_SITE_URL=https://www.sypeministry.org
SITE_NAME="SYPE Ministry"

# Optional / still used
YOUTUBE_API_KEY=your_youtube_api_key
CONTACT_EMAIL=sypeministry@gmail.com
CONTACT_PHONE=+250780430990
PING_MESSAGE=pong

# Email (SMTP) - for sending donation receipts
# Note: Render Free Tier blocks SMTP ports (25, 465, 587).
# Use Brevo (HTTPS) instead for free tier deployment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sypeministry@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SYPE Ministry <sypeministry@gmail.com>"

# Brevo API Key (Recommended for Render Free Tier)
# This uses HTTPS and bypasses port blocking.
BREVO_API_KEY=your_brevo_api_key

ADMIN_NOTIFY_EMAIL=sypeministry@gmail.com
ADMIN_TEST_TOKEN=your_test_token