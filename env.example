# Server Configuration
PORT=8080
NODE_ENV=development

# Database (PostgreSQL - Supabase or any PostgreSQL provider)
# Get from Supabase: Project Settings > Database > Connection String
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Configuration (Optional - if using Supabase)
# Get from: Project Settings > API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# YouTube Data API v3 Key (Required for Videos page)
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create/select a project in Google Cloud Console
# 2. Enable "YouTube Data API v3"
# 3. Create API Key and restrict it to YouTube Data API v3
YOUTUBE_API_KEY="your-youtube-api-key-here"

# Site Configuration
SITE_URL=http://localhost:8080
SITE_NAME=SYPE Ministry
CONTACT_EMAIL=sypeministry@gmail.com
CONTACT_PHONE=+250780430990

# Optional: Email Service (for notifications - can add later)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=sypeministry@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_FROM="SYPE Ministry <sypeministry@gmail.com>"

# Optional: Security (for production)
# JWT_SECRET=generate-a-random-secret-string-here
# SESSION_SECRET=generate-another-random-secret-string-here

# Optional: File Upload Limits (in bytes)
MAX_FILE_SIZE=104857600
# 100MB = 100 * 1024 * 1024

# CORS Configuration (Required for production deployment)
# Add your frontend URLs separated by commas (no spaces after commas)
# Example for separate frontend/backend: https://your-frontend.vercel.app,https://www.your-domain.com
# Example for same domain: https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# Optional: For development/testing
PING_MESSAGE="pong"
