// Prisma Schema for SYPE Ministry Admin Panel
// Database: MongoDB

generator client {
  provider = "prisma-client-js"
  engineType = "library"
  // Note: Prisma 7.x supports both prisma-client-js and prisma-client
  // Using prisma-client-js for compatibility
}

datasource db {
  provider = "mongodb"
}

model Member {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  phone       String?
  role        String   // "Student" | "Alumni" | "Admin"
  status      String   // "Active" | "Inactive" | "Pending"
  joinDate    DateTime @default(now())
  department  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("members")
}

model NewsArticle {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  author      String
  publishDate DateTime @default(now())
  excerpt     String
  body        String
  image       String?  // URL to image in Supabase Storage
  featured    Boolean  @default(false)
  category    String?
  tags        String[] // Array of tags
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news_articles")
}

model Project {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  category     String    // "Documentary" | "Posters" | "Articles"
  topic        String
  description  String
  distribution String
  status       String    // "ongoing" | "completed" | "planned"
  year         String
  teamMembers  String[]  // Array of member IDs or names
  startDate    DateTime?
  endDate      DateTime?
  budget       Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("projects")
}

model Event {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  date         DateTime
  time         String
  location     String
  category     String
  rsvpRequired Boolean   @default(false)
  rsvpCount    Int       @default(0)
  maxAttendees Int?
  attendees    String[]  // Array of member IDs or emails
  status       String    // "upcoming" | "ongoing" | "completed" | "cancelled"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("events")
}

model Donation {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  donorName     String
  donorEmail    String
  amount        Float
  currency      String    @default("RWF")
  date          DateTime  @default(now())
  type          String    // "one-time" | "monthly" | "project-based"
  projectId     String?
  paymentMethod String?
  paymentStatus String    @default("unpaid") // "paid" | "unpaid" | "installment"
  receiptSent   Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("donations")
}

model FAQ {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  category String
  question String
  answer   String
  order    Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model MediaFile {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        String    // "image" | "video" | "document"
  url         String    // URL to file in Supabase Storage
  thumbnail   String?   // URL to thumbnail in Supabase Storage
  size        Int       // Size in bytes
  uploadDate  DateTime  @default(now())
  category    String?
  tags        String[]  // Array of tags
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("media_files")
}

model EmailCampaign {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  subject    String
  body       String
  recipients String[]  // Array of email addresses
  sentDate   DateTime?
  status     String    // "draft" | "scheduled" | "sent"
  scheduledDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("email_campaigns")
}

model Devotion {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  title                 String
  date                  DateTime
  excerpt               String
  content               String?
  image                 String?   // URL to image in Supabase Storage
  featuredVideoUrl      String?
  featuredVideoThumbnail String?
  featuredVideoTitle    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("devotions")
}

model ContactSubmission {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  subject     String
  message     String
  status      String    @default("new") // "new" | "read" | "replied" | "archived"
  readAt      DateTime?
  repliedAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("contact_submissions")
}

model Book {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  author      String?
  category    String    // "Health" | "Genzura" | "Ellen G. White Books" | "Bible" | "Inyandiko" | "Integuza" | "Others"
  description String?
  coverImage  String?   // URL to cover image in Supabase Storage
  fileUrl     String?   // URL to PDF/document in Supabase Storage
  isbn        String?
  publisher   String?
  publishDate DateTime?
  language    String?
  pages       Int?
  tags        String[]  // Array of tags
  featured    Boolean   @default(false)
  downloads   Int       @default(0)
  uploadDate  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("books")
}

model CommitteeMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  position String
  name     String
  church   String
  phone    String
  category String   // "leadership" | "team" | "auditor" | "asa_representatives" | "board_chancellors"
  image    String?  // URL to image in Supabase Storage
  email    String?
  order    Int      @default(0)
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("committee_members")
}

model EmailSubscriber {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String?
  subscribedAt DateTime @default(now())
  status       String   @default("active") // "active" | "unsubscribed"
  source       String?
  tags         String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("email_subscribers")
}
